{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:ssg": "vite-ssg build && node scripts/verify-dist-invariants.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:visual": "playwright test visual.spec.ts --project=chromium",
    "test:e2e:visual:update": "playwright test visual.spec.ts --project=chromium --update-snapshots",
    "test:e2e:docker": "docker run --rm --ipc=host -v \"$(pwd):/app\" -w /app mcr.microsoft.com/playwright:v1.62.0-noble npx playwright test",
    "test:e2e:visual:docker": "docker run --rm --ipc=host -v \"$(pwd):/app\" -w /app mcr.microsoft.com/playwright:v1.62.0-noble npx playwright test visual.spec.ts --project=chromium",
    "test:e2e:visual:update-docker": "docker run --rm --ipc=host -v \"$(pwd):/app\" -w /app mcr.microsoft.com/playwright:v1.62.0-noble npx playwright test visual.spec.ts --project=chromium --update-snapshots",
    "lighthouse": "lhci autorun --config=../.github/lighthouse/lighthouserc.json",
    "lighthouse:collect": "lhci collect --config=../.github/lighthouse/lighthouserc.json",
    "coverage": "vitest run --coverage",
    "analyze": "vite build && start dist/stats.html",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write \"src/**/*.{js,ts,vue,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,json,css,scss,md}\""
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@sentry/vue": "^10.70.0",
    "@tailwindcss/vite": "^4.3.1",
    "@unhead/vue": "^2.1.17",
    "@vue/devtools-api": "^8.1.5",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "marked": "^18.0.10",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.1",
    "vite-ssg": "^28.3.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "web-vitals": "^6.1.1"
  },
  "overrides": {
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.5.0",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.10",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "terser": "^5.50.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.11"
  }
}
