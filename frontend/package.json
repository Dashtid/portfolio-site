{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:ssg": "vite-ssg build && node scripts/verify-dist-invariants.mjs",
    "verify:csp": "node scripts/csp-check.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:visual": "playwright test visual.spec.ts --project=chromium",
    "test:e2e:visual:update": "playwright test visual.spec.ts --project=chromium --update-snapshots=changed",
    "test:e2e:docker": "docker run --rm --ipc=host -v \"$(pwd):/app\" -w /app mcr.microsoft.com/playwright:v1.65.1-noble@sha256:1507cbfc550a63a6b7396791ca4f00df17beb56342d2447b3f106c306f525579 npx playwright test",
    "test:e2e:visual:docker": "docker run --rm --ipc=host -e VITE_APP_VERSION=000000000000 -v \"$(pwd):/app\" -w /app mcr.microsoft.com/playwright:v1.65.1-noble@sha256:1507cbfc550a63a6b7396791ca4f00df17beb56342d2447b3f106c306f525579 npx playwright test visual.spec.ts --project=chromium",
    "test:e2e:visual:update-docker": "docker run --rm --ipc=host -e VITE_APP_VERSION=000000000000 -v \"$(pwd):/app\" -w /app mcr.microsoft.com/playwright:v1.65.1-noble@sha256:1507cbfc550a63a6b7396791ca4f00df17beb56342d2447b3f106c306f525579 npx playwright test visual.spec.ts --project=chromium --update-snapshots=changed",
    "lighthouse": "lhci autorun --config=../.github/lighthouse/lighthouserc.json",
    "lighthouse:collect": "lhci collect --config=../.github/lighthouse/lighthouserc.json",
    "coverage": "vitest run --coverage",
    "analyze": "vite build && start dist/stats.html",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write \"src/**/*.{js,ts,vue,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,json,css,scss,md}\""
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@sentry/vue": "^10.78.0",
    "@tailwindcss/vite": "^4.3.5",
    "@unhead/vue": "^2.1.17",
    "@vue/devtools-api": "^8.1.5",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.21.1",
    "marked": "^18.2.1",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.1",
    "vite-ssg": "^28.3.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "1.65.1",
    "@sentry/vite-plugin": "^5.4.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.1.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.14"
  }
}
